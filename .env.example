# PostgreSQL
POSTGRES_DB=subtrack
POSTGRES_USER=subtrack
POSTGRES_PASSWORD=change-me-to-a-long-random-value
DATABASE_URL=postgres://subtrack:change-me-to-a-long-random-value@db:5432/subtrack?sslmode=disable

# Single administrator account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Runtime
APP_PORT=8080
COOKIE_SECURE=false
APP_PUBLIC_URL=

# SMTP notifications (leave blank to disable Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENCRYPTION=starttls

# Telegram notifications (leave blank to disable Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
